{
  "expo": {
    "name": "መንጃ ፍቃድ",
    "slug": "driving-theory-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/መንጃ ፍቃድ በቀላል መንገድ.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/መንጃ ፍቃድ በቀላል መንገድ.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "androidNavigationBar": {
      "barStyle":        "dark-content",
      "backgroundColor": "#f7f9fb"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/መንጃ ፍቃድ በቀላል መንገድ.png",
        "backgroundColor": "#FFFFFF"
      },
      "allowBackup": false,
      "minSdkVersion": 26,
      "targetSdkVersion": 34,
      "compileSdkVersion": 34,
      "package": "com.drivingtheory.ethiopian",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.drivingtheory.ethiopian",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ለድምጽ መልስ ማይክሮፎን ያስፈልጋል"
      }
    },
    "web": {
      "favicon": "./assets/icons/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "ለድምጽ መልስ ለመናገር ማይክሮፎን ያስፈልጋል። ቁጥሩን ለመናገር ብቻ ይጠቅማል።"
        }
      ]
    ],
    "scheme": "drivingtheory",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
