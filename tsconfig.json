{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "dashboard",
    "scripts",
    "backend/generateNumberAudio.ts",
    "backend/patchAnswerAudio.ts",
    "backend/uploadContent.ts",
    "backend/uploadPart1.ts"
  ]
}
